# Coducktor does not load this file automatically. Export only the overrides you need.

# ---- state locations ---------------------------------------------------------
# Per-user Coducktor state. Default: ~/.coducktor
# DUCK_HOME=/absolute/path/to/coducktor-state

# Project registry directory. Default: $DUCK_HOME/projects
# DUCK_PROJECTS_DIR=/absolute/path/to/project-registry

# ---- local executables -------------------------------------------------------
# DUCK_CLAUDE_BIN=/absolute/path/to/claude
# DUCK_CODEX_BIN=/absolute/path/to/codex
# DUCK_OPENCODE_BIN=/absolute/path/to/opencode
# DUCK_PI_BIN=/absolute/path/to/pi
# OMP executable override (oh-my-pi)
# DUCK_OMP_BIN=/absolute/path/to/omp
# DUCK_GH_BIN=/absolute/path/to/gh

# ---- bounded harness environment --------------------------------------------
# Coducktor sends a conservative environment allowlist to agent children. Add comma-separated
# variable names only when a local tool needs them.
# DUCK_ENV_PASSTHROUGH=MY_TOOL_HOME,MY_TOKEN

# Compatibility escape hatch: pass the full host environment to agent children. Off by default;
# prefer DUCK_ENV_PASSTHROUGH.
# DUCK_AGENT_ENV_FULL=1

# Codex reasoning-summary override. The conversation composer should be preferred for reasoning
# itself; conversations always run Codex's autonomous sandbox and approval policy.
# DUCK_CODEX_REASONING=auto

# ---- diagnostics and tests ---------------------------------------------------
# Show the TUI frame/debug HUD.
# DUCK_DEBUG_HUD=1

# Prevent external mutations in supported forge/runner test paths.
# DUCK_DRY_RUN=1

# Keep discovered model lists stable while testing settings/catalog behavior.
# DUCK_AGENT_MODELS_LOCKED=1

# Internal runner-fixture hook; not intended for normal use.
# DUCK_MOCK_ARGS_FILE=/absolute/path/to/args.json
